<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG.Pages.EditarSalaPage"
             Title="Editar Sala">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Nombre" />
            <Entry x:Name="entryNombre" Placeholder="Nombre de la sala" />

            <Label Text="Capacidad" />
            <Entry x:Name="entryCapacidad" Keyboard="Numeric" Placeholder="Capacidad" />

            <Label Text="Equipamiento (separado por coma)" />
            <Entry x:Name="entryEquipamiento" Placeholder="Proyector, Pizarra, ..." />

            <Label Text="Estado" />
            <Picker x:Name="pickerEstado">
                <Picker.Items>
                    <x:String>Disponible</x:String>
                    <x:String>Ocupada</x:String>
                    <x:String>En Mantenimiento</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Guardar Cambios" Clicked="GuardarCambios_Clicked" BackgroundColor="#6200EE" TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>