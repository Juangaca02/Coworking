<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG.Pages.RegisterPage"
             Title="Registro">
    <ContentPage.Background>
        <LinearGradientBrush EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.0" />
            <GradientStop Color="#F3E5F5" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout Padding="30" Spacing="20">

        <Label Text="Usuario" FontSize="Medium"/>
        <Entry Placeholder="Usuario" Text="{Binding Usuario}" />

        <Label Text="Email" FontSize="Medium"/>
        <Entry Placeholder="Email" Text="{Binding Email}" />

        <Label Text="Contraseña" FontSize="Medium"/>
        <Entry Placeholder="Contraseña" Text="{Binding Contraseña}" IsPassword="True" />

        <Label Text="Confirmar Contraseña" FontSize="Medium"/>
        <Entry Placeholder="Confirmar Contraseña" Text="{Binding ConfirmarContraseña}" IsPassword="True" />

        <Button Text="Registrarse" Command="{Binding RegistrarCommand}" />
    </VerticalStackLayout>
</ContentPage>