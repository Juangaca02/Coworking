<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TFG.ViewModel"
             x:Class="TFG.Pages.LoginPage"
             Title="Inicio Sesion">
    <ContentPage.Background>
        <LinearGradientBrush EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.0" />
            <GradientStop Color="#F3E5F5" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout Padding="30" Spacing="20">

        <Label Text="Usuario" FontSize="Medium"/>
        <Entry Placeholder="Usuario" Text="{Binding Usuario}" />

        <Label Text="Contraseña" FontSize="Medium"/>
        <Entry Placeholder="Contraseña" IsPassword="True" Text="{Binding Contraseña}" />

        <Button Text="Iniciar sesión" BackgroundColor="#4CAF50" Command="{Binding IniciarSesionCommand}" />

        <Button Text="¿No tienes cuenta?" BackgroundColor="Red" Command="{Binding IrARegistroCommand}" />
    </VerticalStackLayout>
</ContentPage>