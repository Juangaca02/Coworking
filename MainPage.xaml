<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TFG.MainPage"
             BackgroundColor="White"
             Title="Inicio">
    <ContentPage.Background>
        <LinearGradientBrush EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.0" />
            <GradientStop Color="#F3E5F5" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <Grid>
        <!-- Imagen de fondo desenfocada -->
        <Image x:Name="imgFondo"
            Source="background.jpg"
            Aspect="AspectFill"
            Opacity="0.3"/>
        <ScrollView>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Image Grid.Row="0"
                    Source="icono.png" 
                    WidthRequest="120"
                    HeightRequest="120"
                    HorizontalOptions="Center"/>

                <!-- Bienvenida -->
                <Label Grid.Row="1"
                    Text="Bienvenido a la aplicación Coworking"
                    FontSize="25"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="Black"
                    Margin="0,10"/>

                <!-- Texto explicativo -->
                <Label Grid.Row="2"
                    Text="Consulta la disponibilidad de salas, visualiza sus detalles y gestiona tus reservas de forma rápida y sencilla."
                    FontSize="18"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="Black"
                    Margin="20,10"/>

                <!-- Botones opcionales: Login/Register -->
                <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center"  Spacing="10" Padding="20">
                    <Button x:Name="btnLogin"
                        WidthRequest="150"
                        HeightRequest="40"
                        Text="Iniciar sesión"
                        Clicked="OnLoginClicked"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="10"
                        IsVisible="False"/>
                    <Button x:Name="btnRegister"
                        WidthRequest="150"
                        HeightRequest="40"
                        Text="Registrarse"
                        Clicked="OnRegisterClicked"
                        BackgroundColor="red"
                        TextColor="white"
                        CornerRadius="10"
                        IsVisible="False"/>
                    <Label x:Name="lblInfo"
                        Text="¡Ya estás logueado!"
                        IsVisible="False"
                        FontSize="18"
                        HorizontalOptions="Center"
                        TextColor="DarkGreen"
                        FontAttributes="Italic,Bold" />
                </HorizontalStackLayout>


                <!-- Footer con redes sociales -->
                <StackLayout Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalOptions="Center"
                        Margin="0,30,0,20"
                        Spacing="30">
                    <Image Source="icon_facebook.png" WidthRequest="30" HeightRequest="30"/>
                    <Image Source="icon_instagram.png" WidthRequest="30" HeightRequest="30"/>
                    <Image Source="icon_twitter.png" WidthRequest="30" HeightRequest="30"/>
                </StackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
