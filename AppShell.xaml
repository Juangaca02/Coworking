<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TFG"
    xmlns:pages="clr-namespace:TFG.Pages"
    x:Class="TFG.AppShell">
    <Shell.FlyoutBackground>
        <LinearGradientBrush EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F3E5F5" Offset="1.0"/>
        </LinearGradientBrush>
    </Shell.FlyoutBackground>
    <Shell.FlyoutHeader>
        <StackLayout Padding="10" Orientation="Vertical" HorizontalOptions="FillAndExpand" VerticalOptions="Start" Spacing="10">
            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                <Image x:Name="imgUsuarioFlyout" WidthRequest="50" HeightRequest="50" Aspect="AspectFill" Margin="0,0,10,0"/>
                <Label x:Name="UsuarioLabel" Text="Usuario" VerticalOptions="Center" FontSize="20" HorizontalOptions="StartAndExpand" />
            </StackLayout>
            <Label x:Name="UsuarioAdminLabel" Text="(Usuario Admin)" IsVisible="False" VerticalOptions="Start" HorizontalOptions="StartAndExpand"  FontSize="14"  TextColor="Gray" />
        </StackLayout>
    </Shell.FlyoutHeader>


    <!-- Menú de navegación -->
    <FlyoutItem Title="Menú Principal" Icon="inicio.png" IsVisible="True" x:Name="menuPrincipal" Route="menuPrincipal">
        <ShellContent Route="default" ContentTemplate="{DataTemplate views:MainPage}" x:Name="DefaultContent" />
        <Tab Title="Historial" Icon="historial.png" IsVisible="False" x:Name="TabHistorial" Route="TabHistorial" Shell.TabBarBackgroundColor="#F3E5F5">
            <ShellContent ContentTemplate="{DataTemplate pages:HistorialPage}" Route="historial" />
        </Tab>
        <Tab Title="Inicio" Icon="inicio.png" IsVisible="False" x:Name="TabInicio" Route="TabInicio" Shell.TabBarBackgroundColor="#F3E5F5">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="inicio" />
        </Tab>
        <Tab Title="Salas" Icon="reserva.png" IsVisible="False" x:Name="TabSalas" Route="TabSalas" Shell.TabBarBackgroundColor="#F3E5F5">
            <ShellContent ContentTemplate="{DataTemplate pages:SalasPage}" Route="salas" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Login" Icon="login.png" IsVisible="False" x:Name="LoginMenuItem" Route="login">
        <ShellContent ContentTemplate="{DataTemplate pages:LoginPage}" Route="loginPage" />
    </FlyoutItem>

    <FlyoutItem Title="Registrar" Icon="registro.png" IsVisible="False" x:Name="RegisterMenuItem" Route="register">
        <ShellContent ContentTemplate="{DataTemplate pages:RegisterPage}" Route="registerPage" />
    </FlyoutItem>

    <!-- Aquí agregamos las páginas de contenido, pero las ocultamos si no está logueado -->
    <FlyoutItem Title="Salas" IsVisible="False" x:Name="SalasMenuItem" Route="salasMenu">
        <ShellContent ContentTemplate="{DataTemplate pages:SalasPage}" Route="salasPage" />
    </FlyoutItem>

    <FlyoutItem Title="Ajustes" Icon="ajuste.png" IsVisible="True" x:Name="SalasAjustesUsuario" Route="ajustesUsuario">
        <ShellContent ContentTemplate="{DataTemplate pages:AjustesPage}" Route="ajustesPage" />
    </FlyoutItem>

    <!-- Footer -->
    <Shell.FlyoutFooter>
        <StackLayout Padding="10" VerticalOptions="EndAndExpand" Spacing="10">
            <Button x:Name="btnCerrarSesion" Text="Cerrar sesión" BackgroundColor="#D32F2F" TextColor="White" Clicked="CerrarSesion_Clicked" />
            <Label Text="Acerca de la aplicacion" FontSize="12" HorizontalOptions="Center"/>
        </StackLayout>
    </Shell.FlyoutFooter>

</Shell>
